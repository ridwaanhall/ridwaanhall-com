# ---------------------------------------------------------------------------
# ridwaanhall.com environment.
#
# The STORAGE_-prefixed names look redundant and are kept verbatim on purpose:
# they are what Vercel's Supabase integration provisions, so `vercel env pull`
# keeps working without a manual re-sync whenever the project or its keys
# change.
#
# Copy to `.env.local`. Nothing here has a default -- the app will not start
# without the database URL, and will fail quietly rather than loudly for the
# rest (no key means no email, no spam check, no dashboard panel).
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Supabase Postgres -- pooled (pgbouncer, transaction mode) for runtime traffic,
# direct for DDL and introspection.
STORAGE_POSTGRES_URL=""
STORAGE_POSTGRES_URL_NON_POOLING=""

# Supabase Storage
STORAGE_SUPABASE_URL=""
STORAGE_SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# Auth.js v5
AUTH_SECRET=""
AUTH_URL=""
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# External APIs (dashboard)
GITHUB_ACCESS_TOKEN=""
WAKATIME_API_KEY=""

# Cloudflare Turnstile (contact form)
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=""
CF_TURNSTILE_SECRET_KEY=""

# Email, over Resend's HTTP API.
#
# These two are different addresses doing different jobs, and swapping them
# breaks the conversation rather than the send:
#
#   DEFAULT_FROM_EMAIL       the From on every message. Must be on a domain
#                            verified at resend.com/domains, or every send fails
#                            with a 403 that names the domain. There is no
#                            fallback: `sendEmail` logs and returns false, so
#                            the contact form reports a problem and nothing
#                            arrives. Nobody reads replies sent here.
#
#   CONTACT_EMAIL_RECIPIENT  the human inbox. Comma-separated for more than one.
#                            It is where notifications land *and* the Reply-To
#                            on everything sent to a visitor, so it has to be an
#                            address that can receive mail.
#
# Reply-To is what routes a conversation, since From is fixed: a notification
# replies to whoever wrote in, a visitor's copy replies here. Left unset,
# `ownerEmails()` falls back to DEFAULT_FROM_EMAIL and every reply is lost.
RESEND_API_KEY=""
DEFAULT_FROM_EMAIL="notify@updates.your-domain.com"
CONTACT_EMAIL_RECIPIENT="hi@your-domain.com"

# Feature flags
NEXT_PUBLIC_GUESTBOOK_ENABLED=true

# ---------------------------------------------------------------------------
# Cloudflare Workers
#
# The Worker deployment at v3.ridwaanhall.com reads the same keys, but they
# arrive by two different routes and the split is not cosmetic.
#
#   Runtime secrets   `wrangler secret bulk`, read from `process.env` inside the
#                     isolate. Everything below except the three build-only
#                     entries.
#
#   Build variables   set on the Workers Builds configuration in the dashboard.
#                     `next build` prerenders this whole site, so the build
#                     reads the database and resolves media URLs -- and every
#                     NEXT_PUBLIC_ value is *inlined into the bundle* at that
#                     point, which means setting one as a runtime secret has no
#                     effect at all. These are needed in both places:
#
#                       STORAGE_POSTGRES_URL   prerendering queries it directly;
#                                              Hyperdrive exists only inside a
#                                              Worker, and there is no Worker
#                                              during a build
#                       STORAGE_SUPABASE_URL   next.config.ts derives the image
#                                              remotePatterns and the CSP
#                                              img-src from it
#                       NEXT_PUBLIC_*          inlined, as above
#
# STORAGE_POSTGRES_URL is deliberately *not* a runtime secret on the Worker.
# Supabase's certificate cannot be verified from a Worker, so a connection made
# with it would fail; `lib/db/client.ts` reaches for the HYPERDRIVE binding
# instead, and leaving the variable unset is what keeps that unambiguous.
#
# AUTH_URL must name the deployment's own origin. Auth.js builds absolute URLs
# from it unconditionally, so a value pointing at the other deployment sends
# anyone signing out of this one to that host instead.
# ---------------------------------------------------------------------------
