# ---------------------------------------------------------------------------
# Next.js app environment.
#
# Generated from the Django `.env` + `.env.local` during the migration. The
# STORAGE_-prefixed names are kept verbatim: they are what Vercel's Supabase
# integration provisions, so `vercel env pull` keeps working without a manual
# re-sync whenever the project or keys change.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Supabase Postgres -- pooled (pgbouncer, transaction mode) for runtime traffic,
# direct for DDL and introspection.
STORAGE_POSTGRES_URL=""
STORAGE_POSTGRES_URL_NON_POOLING=""

# Supabase Storage
STORAGE_SUPABASE_URL=""
STORAGE_SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# Auth.js v5
AUTH_SECRET=""
AUTH_URL=""
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# External APIs (dashboard)
GITHUB_ACCESS_TOKEN=""
WAKATIME_API_KEY=""

# Cloudflare Turnstile (contact form)
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=""
CF_TURNSTILE_SECRET_KEY=""

# Email -- Resend replaces Django's Gmail SMTP at phase 2.
RESEND_API_KEY=""
DEFAULT_FROM_EMAIL=""
CONTACT_EMAIL_RECIPIENT=""

# Feature flags
NEXT_PUBLIC_GUESTBOOK_ENABLED=true
